{
  "info": {
    "_postman_id": "661b220d-cc8e-4da7-bc15-d73d72a7f31d",
    "name": "Absher Local API",
    "description": "Local-only manual API checks. Start the app with APP_DEMO_DATA_ENABLED=true before using this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Health is UP', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "Enrollment",
      "item": [
        {
          "name": "1. Request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nationalId\": \"{{enrollmentNationalId}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/enrollment/otp"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('OTP request accepted', () => pm.response.to.have.status(202));", "pm.environment.set('challengeId', pm.response.json().challengeId);"] } }]
        },
        {
          "name": "2. Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{otpCode}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/enrollment/otp/verify"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('OTP is verified', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "3. Create citizen account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"email\": \"{{newCitizenEmail}}\",\n  \"password\": \"{{newCitizenPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/enrollment/accounts"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Citizen account created', () => pm.response.to.have.status(201));"] } }]
        }
      ]
    },
    {
      "name": "Citizen",
      "item": [
        {
          "name": "1. Login existing citizen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{existingCitizenEmail}}\",\n  \"password\": \"{{localPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Citizen login succeeds', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.environment.set('citizenAccessToken', body.accessToken);", "pm.environment.set('citizenRefreshToken', body.refreshToken);"] } }]
        },
        {
          "name": "2. Submit passport request",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{citizenAccessToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/v1/me/passport-requests"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Request created', () => pm.response.to.have.status(201));", "pm.environment.set('requestId', pm.response.json().id);"] } }]
        },
        {
          "name": "3. My passport request history",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{citizenAccessToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/v1/me/passport-requests/{{requestId}}/history"
          }
        }
      ]
    },
    {
      "name": "Employee review",
      "item": [
        {
          "name": "1. Login employee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{localPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Employee login succeeds', () => pm.response.to.have.status(200));", "pm.environment.set('employeeAccessToken', pm.response.json().accessToken);"] } }]
        },
        {
          "name": "2. Start review",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeAccessToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/v1/operations/passport-requests/{{requestId}}/review"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Review started', () => pm.response.to.have.status(200));", "pm.environment.set('employeeAccountId', pm.response.json().reviewedBy.value);"] } }]
        },
        {
          "name": "3. Reject with reason",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeAccessToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"approved\": false,\n  \"reason\": \"Missing supporting document\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/operations/passport-requests/{{requestId}}/decision"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Request rejected', () => pm.response.to.have.status(200));", "pm.test('Status is REJECTED', () => pm.expect(pm.response.json().status).to.eql('REJECTED'));"] } }]
        }
      ]
    },
    {
      "name": "Session security",
      "item": [
        {
          "name": "1. Refresh citizen session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{citizenRefreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Refresh succeeds', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.environment.set('citizenAccessToken', body.accessToken);", "pm.environment.set('citizenRefreshToken', body.refreshToken);"] } }]
        },
        {
          "name": "2. Logout citizen session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{citizenRefreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Logout succeeds', () => pm.response.to.have.status(204));"] } }]
        }
      ]
    }
  ]
}
