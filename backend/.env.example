# Development-only database settings. Do not commit a real .env file.
DB_URL=jdbc:mysql://localhost:3306/absher?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=absher
DB_PASSWORD=replace-with-a-local-secret

# Comma-separated browser origins allowed to call the API in production.
APP_ALLOWED_ORIGINS=https://app.example.com

# Required in production. Generate two different random 32-byte keys and Base64-encode them.
APP_LOOKUP_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key
APP_ENCRYPTION_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key

# JWT signing is separate from data encryption. Use a different random 32-byte key.
APP_JWT_ISSUER=https://api.example.com
APP_JWT_SIGNING_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key
APP_JWT_ACCESS_TOKEN_LIFETIME=PT15M
